{
  "manifest_version": 3,
  "name": "Jobsy Clipper",
  "version": "0.1.0",
  "description": "Save the job posting in the current tab to your Jobsy tracker.",
  "action": {
    "default_title": "Save to Jobsy",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*", "http://*/*"]
}
